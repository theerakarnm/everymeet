{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everymeet-meet-spike",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "MeetSpike",
      // On podman, deploy fails with IMAGE_REGISTRY_DOESNT_CONTAIN_IMAGE because the local digest differs
      // from the pushed one. After the first (failed) deploy has pushed the image, point this at the pushed
      // tag from `wrangler containers images list`: registry.cloudflare.com/<account-id>/everymeet-meet-spike-meetspike:<tag>
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-2",
      "max_instances": 2
    }
  ],
  "durable_objects": { "bindings": [{ "name": "MEET_SPIKE", "class_name": "MeetSpike" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MeetSpike"] }]
}

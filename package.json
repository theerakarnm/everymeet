{
  "name": "meeting-minutes-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discord bot that records voice meetings per speaker, transcribes them and posts Thai meeting minutes",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "register": "node --env-file-if-exists=.env dist/register-commands.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --experimental-test-module-mocks --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@discordjs/voice": "^0.19.2",
    "@hono/node-server": "^2.1.4",
    "discord.js": "^14.27.0",
    "hono": "^4.13.13",
    "opusscript": "^0.0.8",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

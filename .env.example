# --- Discord (optional; /record is off when DISCORD_TOKEN is unset) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one server instantly (otherwise global, up to 1h)
DISCORD_GUILD_ID=

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meeting-recordings

# --- OpenRouter ---
OPENROUTER_API_KEY=
TRANSCRIBE_MODEL_PRIMARY=microsoft/mai-transcribe-2
TRANSCRIBE_MODEL_FALLBACK=google/gemini-3.5-transcribe
SUMMARY_MODEL_PRIMARY=anthropic/claude-sonnet-5.5
SUMMARY_MODEL_FALLBACK=openai/gpt-6.1-sol-pro
TRANSCRIBE_CONCURRENCY=4

# --- Playback page (PIN protected) ---
PUBLIC_BASE_URL=https://meet.example.com
# Source of the code this server runs (AGPL section 13); change it if you run modified code
SOURCE_CODE_URL=
WEB_PORT=8787
# openssl rand -base64 48
SESSION_SECRET=
TRUST_PROXY=true

# --- Behaviour ---
MINUTES_CHANNEL_NAME=meeting-of-minutes
FALLBACK_CHANNEL_NAME=general
CONTINUE_PROMPT_AFTER_MIN=120
CONTINUE_PROMPT_TIMEOUT_MIN=5
EMPTY_CHANNEL_TIMEOUT_MIN=3
CLEANUP_LOCAL=true

# --- Google Meet recording (optional; off when MEET_RECORDER_URL is unset) ---
# Worker origin printed by the deploy in meet/, e.g. https://everymeet-meet-recorder.<subdomain>.workers.dev
MEET_RECORDER_URL=
# Same value as the Worker secret RECORDER_TOKEN: openssl rand -base64 48
MEET_RECORDER_TOKEN=
# Bot Google account session from `npm run meet:login` in meet/; on the VPS: /run/secrets/meet/meet-auth.json
# (docker compose mounts ./secrets there). Leave empty to join as a guest, which Meet refuses more often.
MEET_AUTH_STATE_FILE=
MEET_MAX_DURATION_MIN=240
# Optional: who may sign in on <PUBLIC_BASE_URL>/meet and whose calendar invitations are recorded:
# addresses and whole domains, comma separated, e.g. alice@example.com, @example.org
ALLOWED_EMAILS=
# Login emails in 24 hours, all addresses together; over it nobody gets a link
MEET_LOGIN_MAIL_DAILY_CAP=300
# Calendar starts: the bot Google account that people invite to calendar events;
# it never gets the minutes
MEET_BOT_EMAIL=bot@example.com
# Calendar starts (off when empty): the bot account's Google Calendar "Secret address in iCal format"
# (Settings for my calendars > Integrate calendar). Treat it like a password.
CALENDAR_ICAL_URL=

# --- Email (Resend; required for the /meet page and the calendar) ---
# Resend API key with "Sending access" restricted to the sender's domain
RESEND_API_KEY=
# Any address on the domain verified in Resend
EMAIL_FROM=minutes@mail.example.com

# --- HTTP API (optional; /api/v1 is off when API_KEYS is unset; see docs/api.md) ---
# name:key pairs, comma separated; key: openssl rand -base64 36 | tr '+/' '-_' | tr -d '='
# List one name twice with two keys to rotate a key without downtime.
API_KEYS=
API_RATE_LIMIT_PER_MIN=120
# Signs webhooks (Standard Webhooks): echo "whsec_$(openssl rand -base64 32)"
WEBHOOK_SECRET=
# Default webhook URL for API recordings, https (http only on localhost)
WEBHOOK_URL=
# More origins a start request may name in webhookUrl, comma separated
WEBHOOK_ALLOWED_ORIGINS=
